{% schema %}
{
  "name": "Retner Widget",
  "target": "body",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_spin_wheel",
      "label": "Enable Spin Wheel",
      "default": true
    },
    {
      "type": "text",
      "id": "api_base_url",
      "label": "API Base URL",
      "info": "The base URL of your backend API. Must be HTTPS (e.g. https://yourdomain.com). HTTP will not work on live stores.",
      "default": "https://test.thebotmode.com"
    }
  ]
}
{% endschema %}

{% if block.settings.enable_spin_wheel %}
  <script data-retner-loader>
    (function() {
      console.log("[Retner] Loader Version 123 - Initializing...");

      var shop = "{{ shop.permanent_domain }}";
      var rawApiBase = "{{ block.settings.api_base_url | strip }}";
      if (!rawApiBase || rawApiBase.trim() === "") rawApiBase = "https://test.thebotmode.com";
      var apiBase = rawApiBase.replace(/^http:\/\//i, "https://");

      console.log("[Retner] Shop:", shop);
      console.log("[Retner] API Base:", apiBase);

      if (!shop || shop.trim() === "") {
        console.error("[Retner] No shop domain found. Widget will not load.");
        return;
      }

      function getVisitorId() {
        var cookieNames = ["_retner_vid", "visitorId", "retner_vid", "visitor_id"];
        for (var i = 0; i < cookieNames.length; i++) {
          var match = document.cookie.match(
            new RegExp("(^|;)\\s*" + cookieNames[i] + "\\s*=\\s*([^;]+)")
          );
          if (match && match[2]) {
            var val = decodeURIComponent(match[2].trim());
            if (val && val !== "undefined" && val !== "null") return val;
          }
        }
        var storageKeys = ["retner_visitor_id", "visitorId", "visitor_id", "_retner_vid", "retner_vid"];
        for (var j = 0; j < storageKeys.length; j++) {
          try {
            var id = localStorage.getItem(storageKeys[j]);
            if (id && id !== "undefined" && id !== "null") return id.trim();
          } catch(e) {}
        }
        return "";
      }

      var HEADERS = { "ngrok-skip-browser-warning": "69420" };
      var cartPollInterval = null;
      var widgetLoaded = false;
      var lastCartCount = -1;

      function buildCartSummary(cartData) {
        return {
          item_count: cartData.item_count || 0,
          total_price: cartData.total_price || 0,
          items: (cartData.items || []).map(function(item) {
            return { title: item.title || '', price: item.price || 0 };
          })
        };
      }

      function injectWidget(tool, visitorId) {
        if (widgetLoaded) return;
        widgetLoaded = true;
        if (cartPollInterval) clearInterval(cartPollInterval);

        console.log("[Retner] Loading widget bundle from:", apiBase + "/widget.js");
        fetch(apiBase + "/widget.js", { headers: HEADERS })
          .then(function(r) {
            if (!r.ok) {
              console.error("[Retner] widget.js fetch failed, status:", r.status);
              return null;
            }
            return r.text();
          })
          .then(function(code) {
            if (!code) return;
            var script = document.createElement("script");
            script.setAttribute("data-shop", shop);
            script.setAttribute("data-tool-id", tool._id);
            script.setAttribute("data-api-base", apiBase);
            script.textContent = code;
            document.body.appendChild(script);
            console.log("[Retner] widget.js injected successfully!");
          })
          .catch(function(e) {
            console.error("[Retner] widget.js fetch failed:", e);
          });
      }

      function checkTrigger(tool, visitorId) {
        fetch('/cart.js')
          .then(function(r) { return r.json(); })
          .catch(function() { return {}; })
          .then(function(cartData) {
            var cartSummary = buildCartSummary(cartData);
            return fetch(apiBase + "/api/lead-capture/" + tool._id + "/check-trigger", {
              method: 'POST',
              headers: Object.assign({ 'Content-Type': 'application/json' }, HEADERS),
              body: JSON.stringify({
                shop: shop,
                device: /Mobi|Android/i.test(navigator.userAgent) ? "mobile" : "desktop",
                visitorType: localStorage.getItem("retner_is_subscriber")
                  ? "subscriber"
                  : (localStorage.getItem("retner_has_visited") ? "returning" : "new"),
                currentUrl: window.location.href,
                visitorId: visitorId,
                cart: cartSummary,
                product: {},
                lastVisitedProduct: localStorage.getItem('retner_last_visited_product') || ''
              })
            });
          })
          .then(function(r) {
            console.log("[Retner] Trigger check status:", r.status);
            return r.ok ? r.json() : null;
          })
          .then(function(trigger) {
            if (!trigger) {
              console.warn("[Retner] Trigger response empty.");
              return;
            }
            console.log("[Retner] Trigger result:", trigger.shouldShow, trigger.reason || "");

            if (trigger.shouldShow) {
              injectWidget(tool, visitorId);
              return;
            }

            console.log("[Retner] Trigger conditions not met:", trigger.reason);

            // Cart trigger fail hua — polling shuru karo
            if (trigger.canRetry && !cartPollInterval) {
              console.log("[Retner] Starting cart polling for behaviour trigger...");
              cartPollInterval = setInterval(function() {
                if (widgetLoaded) { clearInterval(cartPollInterval); return; }
                fetch('/cart.js')
                  .then(function(r) { return r.json(); })
                  .then(function(cartData) {
                    var count = cartData.item_count || 0;
                    if (count !== lastCartCount) {
                      lastCartCount = count;
                      console.log("[Retner] Cart changed (" + count + " items) — re-checking trigger...");
                      checkTrigger(tool, visitorId);
                    }
                  })
                  .catch(function() {});
              }, 3000);

              // 10 min baad polling band
              setTimeout(function() {
                if (cartPollInterval) clearInterval(cartPollInterval);
              }, 600000);
            }
          })
          .catch(function(e) {
            console.error("[Retner] Trigger check failed:", e);
          });
      }

      // 1. Config fetch
      fetch(apiBase + "/api/lead-capture/widget/config?shop=" + encodeURIComponent(shop), {
        headers: HEADERS
      })
        .then(function(r) {
          console.log("[Retner] Config fetch status:", r.status);
          return r.ok ? r.json() : null;
        })
        .then(function(data) {
          if (!data || !data.tools || data.tools.length === 0) {
            console.warn("[Retner] No active tools found for shop:", shop);
            return;
          }

          if (data.themeMigrationWarning) {
            console.warn("[Retner] Legacy theme detected. Please migrate to App Embed.");
          }

          var tool = data.tools[0];
          console.log("[Retner] Checking triggers for tool:", tool._id);

          var visitorId = getVisitorId();
          if (!visitorId) {
            console.warn("[Retner] No _retner_vid found. Retner Tracking is OFF. Widget will not load.");
            return;
          }
          console.log("[Retner] visitorId found:", visitorId);

          // 2. Real cart data ke saath trigger check
          checkTrigger(tool, visitorId);
        })
        .catch(function(e) {
          console.error("[Retner] Config fetch failed:", e);
          console.error("[Retner] Is backend running? URL was:", apiBase);
        });
    })();
  </script>
{% endif %}